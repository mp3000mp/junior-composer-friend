{
  "name": "junior-composer-friend",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "Matthias Perret",
  "repository": {
    "type": "git",
    "url": "https://github.com/mp3000mp/junior-composer-friend.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:cov": "vitest run --coverage",
    "test:cov:html": "vitest run --coverage --coverage.reporter=html",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@vueuse/core": "^12.0.0",
    "bootstrap": "^5.3.3",
    "smplr": "^0.20.0",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/eslint-plugin": "1.1.7",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "sass": "^1.80.7",
    "typescript": "~5.6.3",
    "vite": "^8.0.7",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.3",
    "vue-tsc": "^2.1.10"
  }
}
